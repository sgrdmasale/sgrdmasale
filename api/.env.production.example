# Copy this file to /etc/sgrd-masale/app.env on the server. Do not commit it.
NODE_ENV=production
PORT=3001
API_HOST=127.0.0.1
DEFAULT_SHIPPING_COST=50

# Public address(es) permitted to call Express directly from a browser.
CORS_ORIGIN=https://example.com,https://www.example.com

# MongoDB connection. Do not expose this value to the browser.
MONGODB_URI=mongodb://127.0.0.1:27017/sgrd_masale
MONGODB_DB=sgrd_masale
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Payment and external service credentials
RAZORPAY_MODE=live
RAZORPAY_KEY_ID=rzp_live_replace_me
RAZORPAY_KEY_SECRET=replace_me
DELHIVERY_API_KEY=replace_me
GOOGLE_PLACES_API_KEY=replace_me
GOOGLE_PLACE_ID=replace_me
